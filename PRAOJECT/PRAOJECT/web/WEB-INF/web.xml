<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Crime Management System - AJT Project (01CE0308)</display-name>
    <description>
        Gujarat Police Crime Management Portal implementing Java Servlets, JSP, JSTL, and Spring REST.
    </description>

    <!-- 1. Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.police.web.servlets.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/dashboard/*</url-pattern>
        <url-pattern>/criminals/*</url-pattern>
        <url-pattern>/firs/*</url-pattern>
    </filter-mapping>

    <!-- 2. Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.police.web.CrimeWebServer$LoginServletHandler</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- 3. Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.police.web.CrimeWebServer$DashboardHandler</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 4. Criminal Management Servlet -->
    <servlet>
        <servlet-name>CriminalServlet</servlet-name>
        <servlet-class>com.police.web.CrimeWebServer$CriminalsHandler</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CriminalServlet</servlet-name>
        <url-pattern>/criminals</url-pattern>
    </servlet-mapping>

    <!-- 5. FIR Management Servlet -->
    <servlet>
        <servlet-name>FIRServlet</servlet-name>
        <servlet-class>com.police.web.CrimeWebServer$FIRHandler</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FIRServlet</servlet-name>
        <url-pattern>/firs</url-pattern>
    </servlet-mapping>

    <!-- 6. Spring REST Dispatcher Servlet -->
    <servlet>
        <servlet-name>dispatcherServlet</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>/WEB-INF/spring-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcherServlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

    <!-- Welcome Page Mapping -->
    <welcome-file-list>
        <welcome-file>views/index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
